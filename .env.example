# Скопируйте в .env:  cp .env.example .env   (файл .env НЕ коммитим)

# --- База данных ---
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=max_sme_support

# --- MAX (токен выдают организаторы) ---
MAX_BOT_TOKEN=
# username бота (для кнопки открытия мини-приложения); сверьте формат в dev.max.ru/docs-api
MAX_BOT_USERNAME=

# --- Web ---
# Локально: :80 (обычный http). На VPS: ваш домен, например app.example.ru — Caddy сам выпустит HTTPS
DOMAIN=:80

# --- Безопасность ---
# Максимальный возраст initData (секунды)
INIT_DATA_MAX_AGE_SECONDS=86400
# Только для локальной разработки в обычном браузере, в production игнорируется:
DEV_AUTH_BYPASS=false
